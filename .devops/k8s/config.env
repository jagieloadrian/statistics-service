# Jawna konfiguracja statistics-service -> ConfigMap statistics-service-config (configMapGenerator).
# Sekrety: secrets.sops.env (SOPS). Opis zmiennych: homelab-infra docs/setup.md.
DB_URL=jdbc:postgresql://postgres.apps.svc.cluster.local:5432/statistics?currentSchema=statistics
DB_USER=statistics
ADMIN_EMAIL=admin@home.arpa
AUTH_LOCAL=true
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_NAME=SSO
CORS_HOSTS=statistics.home.arpa
TRUST_PROXY=true
LOG_FORMAT=json
BROKER=none
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_GROUP_ID=statistics-service
KAFKA_TOPIC=stats.ingest
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
NATS_URL=nats://nats.apps.svc.cluster.local:4222
NATS_STREAM=STATS_INGEST
NATS_SUBJECT_PREFIX=stats.ingest
NATS_DURABLE=statistics-service
NATS_STREAM_MAX_AGE=7d
NATS_STREAM_MAX_BYTES=268435456
NATS_USER=statistics-service
